          <th>NG Rate</th>
          <th>Last Audit</th>
          <th>Last <?= $LOW_VOLUME_WINDOW_DAYS ?>d</th>
          <th>Flags</th>
        </tr>
      </thead>
      <tbody>
        <?php if ($scorecard): foreach ($scorecard as $s): ?>
        <tr>
          <td><?= e($s['operator']) ?></td>
          <td><?= $s['total_audits'] ?></td>
          <td><?= $s['total_checks'] ?></td>
          <td><?= $s['ng_rate'] ?>%</td>
          <td><?= $s['last_audit'] ? e(substr($s['last_audit'], 0, 16)) : '—' ?>
              <?php if ($s['days_since'] !== null): ?>
              <span style="color:var(--muted);font-size:9.5px"> (<?= $s['days_since'] ?>d ago)</span>
              <?php endif; ?>
          </td>
          <td><?= $s['recent_audits'] ?></td>
          <td>
            <?php foreach ($s['flags'] as $f): ?>
              <span class="badge-pill <?= $f['cls'] ?>" style="font-size:9px"><?= e($f['label']) ?></span>
            <?php endforeach; ?>
          </td>
        </tr>
        <?php endforeach; else: ?>
        <tr><td colspan="7" class="text-muted" style="padding:18px">No audit data yet.</td></tr>
        <?php endif; ?>
      </tbody>
    </table>
