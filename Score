    variation between shifts.
  </div>
  <div class="panel-body flush">
    <table class="data-table">
      <thead>
        <tr>
          <th>Line</th>
          <th>Model</th>
          <th>Stage</th>
          <th>Auditor</th>
          <th>Checks</th>
          <th>Their NG Rate</th>
          <th>Peers' NG Rate</th>
          <th>Deviation</th>
        </tr>
      </thead>
      <tbody>
        <?php if ($outliers): foreach ($outliers as $o):
              $devCls = abs($o['deviation']) >= $DEVIATION_FLAG_PTS * 2 ? 'badge-red' : 'badge-amber';
        ?>
        <tr>
          <td><?= e($o['line']) ?></td>
          <td><?= e($o['model']) ?></td>
          <td><?= e($o['stage']) ?></td>
          <td><?= e($o['operator']) ?></td>
          <td><?= $o['checks'] ?></td>
          <td><?= $o['own_rate'] ?>%</td>
          <td><?= $o['peer_rate'] ?>%</td>
          <td><span class="badge-pill <?= $devCls ?>"><?= $o['deviation'] > 0 ? '+' : '' ?><?= $o['deviation'] ?>pts (<?= $o['direction'] ?>)</span></td>
        </tr>
        <?php endforeach; else: ?>
