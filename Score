</div>

<section class="panel" style="margin-bottom:24px">
  <div class="panel-head">
    <div class="panel-title">Auditor Volume &amp; Activity</div>
    <span class="panel-sub"><?= $totalAuditors ?> auditors</span>
  </div>
  <div class="panel-body flush">
    <table class="data-table">
      <thead>
        <tr>
          <th>Auditor</th>
          <th>Total Audits</th>
