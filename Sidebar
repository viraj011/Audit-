<?php
/* includes/_sidebar.php — left navigation. Links are real pages; the Admin
   group only appears for users whose role has can_admin. $ASSET = root prefix. */
$ASSET  = $ASSET ?? '';
$ACTIVE = $ACTIVE ?? 'dashboard';
$me     = function_exists('currentUser') ? currentUser() : null;

/* FIX: this used to check a single is_department_only_user() boolean,
 * which had a real bug — it exempted any department user whose ROLE
 * happened to have can_audit=1 set (a common, normal setup, since
 * can_audit is usually just "may use audit.php" on a role rather than
 * "is specifically a dedicated auditor"). A Maintenance/Production
 * account built on such a role saw the FULL sidebar exactly like an
 * unrestricted user. auth.php now resolves one of three tiers via
 * user_access_tier() — 'pqc', 'auditor', or 'department' — and that is
 * the single source of truth this file reads from, matching exactly
 * what requireLogin() enforces server-side. A link is only ever shown
 * here if the tier's page-level gate would actually let the click
 * through — never a dead-end link that immediately redirects away. */
$tier = function_exists('user_access_tier') ? user_access_tier($me) : 'pqc';

// [key, label, icon, href]
$NAV = [
  ['dashboard',   'Dashboard',            'fa-gauge-high',          $ASSET.'dashboard.php'],
  ['audit',       'Manual Audit',         'fa-clipboard-check',     $ASSET.'audit.php'],
  ['auto',        'Auto Audit',           'fa-robot',               $ASSET.'audit.php?mode=auto'],
  ['audits',      'Audit Records',        'fa-table-list',          $ASSET.'audits.php'],
  ['followup',    'Follow-up Audits',     'fa-rotate-right',        $ASSET.'followup.php'],
  ['auditor_history', 'Auditor History',  'fa-user-clock',          $ASSET.'auditor_history.php'],
  // ['rca',         'RCA Module',           'fa-microscope',          $ASSET.'rca.php'],
  ['analytics',   'Analytics',            'fa-chart-pie',           $ASSET.'analytics.php'],
  ['prediction',  'Prediction Dashboard', 'fa-brain',               $ASSET.'predictivedashboard.php'],
];
$ADMIN_NAV = [
  ['admin',       'Admin Home',           'fa-shield-halved', $ASSET.'admin/index.php'],
  ['admin_users', 'Users',                'fa-users',         $ASSET.'admin/users.php'],
  ['admin_roles', 'Roles',                'fa-user-shield',   $ASSET.'admin/roles.php'],
  ['admin_params','Parameters',           'fa-sliders',       $ASSET.'admin/parameters.php'],
  ['admin_lines', 'Production Lines',     'fa-industry',      $ASSET.'admin/lines.php'],
  ['admin_models','Models',               'fa-boxes-stacked', $ASSET.'admin/models.php'],
  ['admin_nc',    'Nonconformities',      'fa-triangle-exclamation', $ASSET.'admin/nonconformities.php'],
  ['admin_capa',  'CAPA Actions',         'fa-clipboard-list',$ASSET.'admin/capa.php'],
  ['audit_edit',  'Edit / Delete Audits', 'fa-pen-to-square', $ASSET.'audit_edit.php'],
];
$QUICK = [
  ['New Manual Audit', 'fa-clipboard-check', $ASSET.'audit.php'],
  ['New Auto Audit',   'fa-robot',           $ASSET.'audit.php?mode=auto'],
  ['New Action / NC',  'fa-triangle-exclamation', $ASSET.'admin/nonconformities.php'],
  ['Add Standard',     'fa-plus',            $ASSET.'admin/parameters.php'],
];

if ($tier === 'department') {
    // Tier 3: exactly one link, matching requireLogin()'s allowlist of
    // exactly one page for this tier. No Quick Actions — every quick
    // action links to a page this tier can't reach.
    $NAV   = [['nc_rca', 'NC Follow-up', 'fa-clipboard-list', $ASSET.'nc_rca.php']];
    $QUICK = [];
} elseif ($tier === 'auditor') {
    // Tier 2: audit entry, audit records, edit/delete, follow-up,
    // auditor history, analytics, and dashboard — matching
    // AUDITOR_ALLOWED_PAGES in auth.php exactly. Prediction Dashboard
    // is intentionally dropped: it isn't on that allowlist, so leaving
    // it visible here would show a link that immediately redirects
    // away the moment it's clicked. Auto Audit shares audit.php's
    // script name (only the query string differs) so it stays.
    $NAV = array_values(array_filter($NAV, fn($n) => $n[0] !== 'prediction'));
    // Auditors don't get the Admin section or admin-linked Quick
    // Actions regardless of what can_admin says on their role — tier
    // is now the deciding signal for nav visibility, not the raw flag.
    $QUICK = array_values(array_filter($QUICK, fn($q) =>
        !str_contains($q[2], 'admin/')
    ));
}
// tier === 'pqc' → full $NAV, full $QUICK, Admin section shown below.

$initials = $me ? strtoupper(substr($me['name'],0,1) . (strpos($me['name'],' ')!==false ? substr($me['name'], strpos($me['name'],' ')+1, 1) : '')) : 'QA';
?>
<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <div class="brand-mark"></div>
    <div class="brand-text"><strong>QATS</strong><small>SIEL Noida &middot; SMD Quality</small></div>
  </div>

  <nav class="sidebar-nav">
    <?php foreach ($NAV as $n): ?>
      <a class="nav-item <?= $ACTIVE === $n[0] ? 'active' : '' ?>" href="<?= htmlspecialchars($n[3]) ?>">
        <i class="fa-solid <?= $n[2] ?>"></i> <?= htmlspecialchars($n[1]) ?>
        <?php if (!empty($n[4])): ?><i class="nav-badge"><?= (int)$n[4] ?></i><?php endif; ?>
      </a>
    <?php endforeach; ?>

    <?php if ($tier === 'pqc' && (!$me || !empty($me['can_admin']))): ?>
      <div class="nav-group-label">Administration</div>
      <?php foreach ($ADMIN_NAV as $n): ?>
        <a class="nav-item <?= $ACTIVE === $n[0] ? 'active' : '' ?>" href="<?= htmlspecialchars($n[3]) ?>">
          <i class="fa-solid <?= $n[2] ?>"></i> <?= htmlspecialchars($n[1]) ?>
        </a>
      <?php endforeach; ?>
    <?php endif; ?>
  </nav>

  <?php if (!empty($QUICK)): ?>
  <div class="quick-actions">
    <div class="quick-head"><span>Quick Actions</span><span class="quick-live"><span class="live-dot"></span>Live</span></div>
    <?php foreach ($QUICK as $q): ?>
      <a class="quick-btn" href="<?= htmlspecialchars($q[2]) ?>"><i class="fa-solid <?= $q[1] ?>"></i> <?= htmlspecialchars($q[0]) ?></a>
    <?php endforeach; ?>
  </div>
  <?php endif; ?>

  <div class="sidebar-user">
    <div class="avatar"><?= htmlspecialchars($initials) ?></div>
    <div><strong><?= htmlspecialchars($me['name'] ?? 'Guest') ?></strong><small><?= htmlspecialchars($me['role_label'] ?? 'Not signed in') ?></small></div>
    <a href="<?= $ASSET ?>logout.php" title="Log out" style="margin-left:auto;color:var(--muted)"><i class="fa-solid fa-arrow-right-from-bracket"></i></a>
  </div>
</aside>
<div class="sidebar-scrim" id="scrim"></div>
