<script>
/* ================================================================ DATA */
const ACH = <?= json_encode($CHART, JSON_UNESCAPED_SLASHES) ?>;
const C = {accent:'#00d4ff',green:'#00e5a0',amber:'#ffb340',red:'#ff4757',purple:'#0F5FA6',blue:'#4d8dff'};
const PAL = [C.green,C.accent,C.amber,C.red];

/* ================================================================ PDF EXPORT */
document.getElementById('btnPdf').addEventListener('click', function(e){
  e.preventDefault();
  var title = 'QATS Audit Records — <?= e(date('d M Y')) ?>';
  var rows  = [];
  document.querySelectorAll('#auditTable tbody tr').forEach(function(tr){
    var cells = [];
    tr.querySelectorAll('td').forEach(function(td){ cells.push(td.innerText.trim()); });
    if(cells.length>1) rows.push(cells);
  });
  // Build a minimal self-contained HTML page and print it
  var head = ['Audit ID','Type','Line','Model','Shift','Operator','NG','Pass %','Date'];
  var thtml = '<table style="width:100%;border-collapse:collapse;font-size:11px;font-family:Arial,sans-serif">'
    +'<thead><tr>'+head.map(h=>'<th style="border:1px solid #ddd;padding:6px 8px;background:#1a2535;color:#fff;text-align:left">'+h+'</th>').join('')+'</tr></thead>'
    +'<tbody>'+rows.map((r,i)=>'<tr style="background:'+(i%2===0?'#f8f9fa':'#fff')+'">'+r.map(c=>'<td style="border:1px solid #ddd;padding:5px 8px">'+c+'</td>').join('')+'</tr>').join('')+'</tbody></table>';
  var kpis = '<?= "Total: ".number_format($sum['total'])." | Avg Pass: ".$sum['avg_pass']."% | Total NG: ".number_format($sum['total_ng'])." | Clean: ".$cleanRate."%" ?>';
  var w = window.open('','_blank');
  w.document.write('<!DOCTYPE html><html><head><title>'+title+'</title>'
    +'<style>body{margin:20px;font-family:Arial,sans-serif}h2{font-size:15px;margin:0 0 6px}p{font-size:11px;color:#666;margin:0 0 14px}</style></head>'
    +'<body><h2>'+title+'</h2><p>Filters applied · '+kpis+'</p>'+thtml+'</body></html>');
  w.document.close();
  setTimeout(function(){ w.print(); }, 400);
});

/* ================================================================ CHARTS */
document.addEventListener('DOMContentLoaded', function(){
  if(!window.Chart) return;
  const css = n => getComputedStyle(document.body).getPropertyValue(n).trim();
  Chart.defaults.font.family = "'JetBrains Mono',monospace";
  Chart.defaults.font.size   = 10;
  Chart.defaults.color       = css('--muted');

  function mk(id, cfg){
    const el = document.getElementById(id);
    if(!el) return;
    try{ new Chart(el, cfg); } catch(err){ console.warn(id, err.message); }
  }
  function yFloor(a){
    const v = (a||[]).filter(x => x != null);
    if(!v.length) return 0;
    return Math.max(0, Math.floor((Math.min(...v) - 5) / 10) * 10);
  }
  const grid = css('--border'), tx = css('--muted'), card = css('--card');

  /* Chart 1 — Time trend (bar + line) */
  if(ACH.time_labels.length){
    mk('cTime', {data:{labels:ACH.time_labels, datasets:[
      {type:'bar',  label:'Audits', data:ACH.time_cnt, backgroundColor:'rgba(139,92,246,.5)', borderRadius:4, maxBarThickness:26, yAxisID:'y'},
      {type:'line', label:'Pass %', data:ACH.time_pr,  borderColor:C.accent, backgroundColor:'rgba(0,212,255,.1)', tension:.4, fill:true, pointRadius:2, yAxisID:'y1'}
    ]}, options:{responsive:true, maintainAspectRatio:false,
      plugins:{legend:{display:true, labels:{boxWidth:10,font:{size:9}}}},
      scales:{x:{grid:{display:false}, ticks:{maxTicksLimit:14,color:tx}},
              y:{grid:{color:grid}, ticks:{color:tx}},
              y1:{position:'right', min:yFloor(ACH.time_pr), max:100, grid:{display:false}, ticks:{color:tx, callback:v=>v+'%'}}}}});
  } else {
    mk('cTime',{type:'bar',data:{labels:['No data'],datasets:[{data:[0],backgroundColor:'rgba(120,120,120,.15)'}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}}}});
  }

  /* Chart 2 — Top lines by NG (horizontal bar) */
  /* ── Line NG chart with stage-breakdown drilldown on click ── */
  var stageByLine = ACH.stage_by_line || {};
  var lineChartObj = null;
  // Stage-breakdown panel (hidden until a bar is clicked)
  var drillDiv = document.getElementById('lineNgDrill');
  var drillChart = null;

  function showDrill(lineName) {
    var stageData = stageByLine[lineName] || [];
    if (!stageData.length || !drillDiv) return;
    drillDiv.style.display = '';
    document.getElementById('lineNgDrillTitle').textContent = 'Stage breakdown — ' + lineName;
    var labels = stageData.map(function(d){ return d.stage; });
    var values = stageData.map(function(d){ return d.count; });
    var palette = ['rgba(255,71,87,.8)','rgba(255,179,64,.8)','rgba(148,0,255,.8)','rgba(0,210,255,.8)','rgba(31,191,122,.8)','rgba(77,141,255,.8)'];
    var canvas = document.getElementById('cLineNgDrill');
    if (!canvas) return;
    if (drillChart) { drillChart.destroy(); drillChart = null; }
    drillChart = new Chart(canvas, { type:'bar',
      data:{ labels:labels, datasets:[{label:'NGs',data:values,
             backgroundColor:palette.slice(0,labels.length),borderRadius:5,maxBarThickness:36}] },
      options:{responsive:true,maintainAspectRatio:false,
        plugins:{legend:{display:false},title:{display:false}},
        scales:{x:{grid:{display:false},ticks:{color:tx}},
                y:{grid:{color:grid},ticks:{color:tx,precision:0}}}}
    });
  }

  if (ACH.line_labels && ACH.line_labels.length) {
    lineChartObj = new Chart(document.getElementById('cLineNg'), { type:'bar',
      data:{labels:ACH.line_labels, datasets:[{label:'NG',data:ACH.line_ng,
        backgroundColor:'rgba(255,71,87,.65)', borderRadius:3, maxBarThickness:18,
        hoverBackgroundColor:'rgba(255,71,87,.9)'}]},
      options:{responsive:true, maintainAspectRatio:false, indexAxis:'y',
        plugins:{legend:{display:false}, tooltip:{callbacks:{
          label:function(ctx){
            var line = ctx.label;
            var stages = stageByLine[line] || [];
            var lines2 = [' Total NG: '+ctx.raw];
            stages.slice(0,4).forEach(function(d){ lines2.push(' '+d.stage+': '+d.count); });
            return lines2;
          }
        }}},
        scales:{x:{grid:{color:grid},ticks:{color:tx,precision:0}},
                y:{grid:{display:false},ticks:{color:tx,font:{size:9}}}},
        onClick:function(evt, els){
          if (!els.length) return;
          var idx = els[0].index;
          var lineName = ACH.line_labels[idx];
          showDrill(lineName);
        }
      }
    });
  } else {
    var noNgEl = document.getElementById('cLineNg');
    if (noNgEl) noNgEl.parentNode.innerHTML='<p style="color:var(--muted);text-align:center;padding:32px;font-size:12px">No NG data in this period.</p>';
  }

  /* Chart 3 — Audit type doughnut */
  if(ACH.type_labels.length){
    const tot = ACH.type_cnt.reduce((a,b)=>a+b,0)||1;
    mk('cType', {type:'doughnut', data:{labels:ACH.type_labels, datasets:[{
        data:ACH.type_cnt, backgroundColor:[C.accent,C.purple,C.green,C.amber,C.red,C.blue],
        borderColor:card, borderWidth:3, hoverOffset:5}]},
      options:{responsive:true, maintainAspectRatio:false, cutout:'58%',
        plugins:{legend:{display:true, position:'right', labels:{boxWidth:10,font:{size:9}}},
          tooltip:{callbacks:{label:c=>`${c.label}: ${c.parsed} (${Math.round(c.parsed/tot*100)}%)`}}}}});
  }

  /* Chart: Overall stage NG distribution */
  if (ACH.stage_labels && ACH.stage_labels.length) {
    var stageColors = ['rgba(255,71,87,.75)','rgba(255,179,64,.75)','rgba(148,0,255,.75)','rgba(0,210,255,.75)','rgba(31,191,122,.75)','rgba(77,141,255,.75)'];
    mk('cStageAll', {type:'bar',
      data:{labels:ACH.stage_labels,
            datasets:[{label:'Total NGs',data:ACH.stage_ng_all,
              backgroundColor:stageColors.slice(0,ACH.stage_labels.length),borderRadius:5,maxBarThickness:36}]},
      options:{responsive:true,maintainAspectRatio:false,
        plugins:{legend:{display:false},tooltip:{callbacks:{label:function(c){return ' NGs: '+c.raw;}}}},
        scales:{x:{grid:{display:false},ticks:{color:tx,font:{size:10}}},
                y:{grid:{color:grid},ticks:{color:tx,precision:0}}}}
    });
  } else {
    var el=document.getElementById('cStageAll');
    if(el) el.parentNode.innerHTML='<p style="color:var(--muted);text-align:center;padding:28px;font-size:12px">No NG stage data yet.</p>';
  }

  /* Chart 4 — Pass-rate band bar */
  const bandLabels = ['≥95% (Excellent)','90–95% (Good)','75–90% (Avg)','<75% (Poor)'];
  const bandCols   = ['rgba(0,229,160,.7)','rgba(0,212,255,.7)','rgba(255,179,64,.7)','rgba(255,71,87,.7)'];
  mk('cBand', {type:'bar', data:{labels:bandLabels, datasets:[{label:'Audits', data:ACH.band,
      backgroundColor:bandCols, borderRadius:5, maxBarThickness:40}]},
    options:{responsive:true, maintainAspectRatio:false,
      plugins:{legend:{display:false}},
      scales:{x:{grid:{display:false}, ticks:{color:tx,font:{size:9}}}, y:{grid:{color:grid}, ticks:{color:tx}}}}});

  /* ── NG per Operator — server-side data, click for stage drilldown ── */
  var stageByOp = ACH.stage_by_op || {};
  var opDrillChart = null;

  function showOpDrill(opName) {
    var data   = stageByOp[opName] || [];
    var panel  = document.getElementById('opDrill');
    var title  = document.getElementById('opDrillTitle');
    var canvas = document.getElementById('cOpDrill');
    if (!panel || !canvas || !data.length) { if (panel) panel.style.display = 'none'; return; }
    panel.style.display = '';
    title.textContent = 'Stage breakdown — ' + opName;
    var pal = ['rgba(255,71,87,.8)','rgba(255,179,64,.8)','rgba(148,0,255,.8)',
               'rgba(0,210,255,.8)','rgba(31,191,122,.8)','rgba(77,141,255,.8)'];
    if (opDrillChart) { opDrillChart.destroy(); opDrillChart = null; }
    opDrillChart = new Chart(canvas, { type:'bar',
      data:{ labels: data.map(function(d){ return d.stage; }),
             datasets:[{ label:'NGs', data: data.map(function(d){ return d.count; }),
               backgroundColor: pal.slice(0, data.length), borderRadius:5, maxBarThickness:36 }] },
      options:{ responsive:true, maintainAspectRatio:false,
        plugins:{ legend:{display:false} },
        scales:{ x:{grid:{display:false},ticks:{color:tx}}, y:{grid:{color:grid},ticks:{color:tx,precision:0}} } }
    });
  }

  if (ACH.op_labels && ACH.op_labels.length) {
    new Chart(document.getElementById('cOp'), { type:'bar',
      data:{ labels: ACH.op_labels,
             datasets:[{ label:'Total NG', data: ACH.op_ng,
               backgroundColor:'rgba(139,92,246,.65)', borderRadius:4, maxBarThickness:28,
               hoverBackgroundColor:'rgba(139,92,246,.9)' }] },
      options:{ responsive:true, maintainAspectRatio:false,
        plugins:{ legend:{display:false},
          tooltip:{ callbacks:{ label:function(ctx) {
            var op     = ctx.label;
            var stages = stageByOp[op] || [];
            var lines2 = [' Total NG: '+ctx.raw, ' Audits: '+(ACH.op_audits[ctx.dataIndex]||0),
                          ' Avg Pass: '+(ACH.op_pass[ctx.dataIndex]||0)+'%'];
            stages.slice(0,4).forEach(function(d){ lines2.push(' '+d.stage+': '+d.count); });
            return lines2;
          }}}},
        scales:{
          x:{ grid:{display:false}, ticks:{color:tx, maxRotation:30, font:{size:9}} },
          y:{ grid:{color:grid}, ticks:{color:tx, precision:0} }
        },
        onClick:function(evt, els){
          if (!els.length) return;
          showOpDrill(ACH.op_labels[els[0].index]);
        }
      }
    });
  } else {
    var opEl = document.getElementById('cOp');
    if (opEl) opEl.parentNode.innerHTML = '<p style="color:var(--muted);text-align:center;padding:28px;font-size:12px">No NG operator data in this period.</p>';
  }
});
</script>
