<?php
/* ============================================================================
 *  audits.php — browse, filter, chart, and export audit records
 *  ---------------------------------------------------------------------------
 *  FIX: this file called e() throughout (used to escape every field in
 *  the row table — audit code, operator, line, model, etc.) but never
 *  required includes/helpers.php, which is where e() is defined. That
 *  produced a fatal "Call to undefined function e()" the instant the
 *  page tried to render the first data row. Reproduced directly against
 *  a real PHP server: with display_errors off (the normal production
 *  setting), that fatal error produces a silently truncated page —
 *  everything up to the point of failure renders (header, filters, KPI
 *  strip), then output just stops, with no visible error and an empty
 *  table body. From the browser this looks exactly like "no audits are
 *  showing" or "the list looks wrong" — the page never gets far enough
 *  to actually render any rows at all, correctly sorted or not.
 * ==========================================================================*/
require_once __DIR__ . '/includes/auth.php';
require_once __DIR__ . '/includes/helpers.php';
require_once __DIR__ . '/includes/components.php';
requireLogin();
$db = db();

/* ---- Filter inputs ------------------------------------------------------- */
$fSearch  = trim($_GET['search']    ?? '');
$fAuditor = trim($_GET['auditor']   ?? '');
$fLine    = trim($_GET['line']      ?? '');
$fModel   = trim($_GET['model']     ?? '');
$fShift   = trim($_GET['shift']     ?? '');
$fType    = trim($_GET['type']      ?? '');
$fResult  = trim($_GET['result']    ?? '');
$fFrom    = trim($_GET['date_from'] ?? '');
$fTo      = trim($_GET['date_to']   ?? '');

/* ---- Dropdown sources ---------------------------------------------------- */
$optAuditors = $db->query("SELECT DISTINCT operator FROM audits WHERE operator<>'' ORDER BY operator")->fetchAll(PDO::FETCH_COLUMN) ?: [];
$optLines    = $db->query("SELECT DISTINCT line    FROM audits WHERE line<>'' ORDER BY line")->fetchAll(PDO::FETCH_COLUMN) ?: [];
$optModels   = $db->query("SELECT DISTINCT model   FROM audits WHERE model IS NOT NULL AND model<>'' ORDER BY model")->fetchAll(PDO::FETCH_COLUMN) ?: [];
$optShifts   = $db->query("SELECT DISTINCT shift   FROM audits WHERE shift<>'' ORDER BY shift")->fetchAll(PDO::FETCH_COLUMN) ?: [];
$optTypes    = $db->query("SELECT DISTINCT audit_type FROM audits WHERE audit_type<>'' ORDER BY audit_type")->fetchAll(PDO::FETCH_COLUMN) ?: [];

/* ---- Build WHERE --------------------------------------------------------- */
$where = ' WHERE 1=1 '; $p = [];
if ($fAuditor !== '') { $where .= ' AND operator = ?';   $p[] = $fAuditor; }
if ($fLine    !== '') { $where .= ' AND line = ?';       $p[] = $fLine; }
if ($fModel   !== '') { $where .= ' AND model = ?';      $p[] = $fModel; }
if ($fShift   !== '') { $where .= ' AND shift = ?';      $p[] = $fShift; }
if ($fType    !== '') { $where .= ' AND audit_type = ?'; $p[] = $fType; }
if ($fResult === 'pass') { $where .= ' AND ng_count = 0'; }
if ($fResult === 'fail') { $where .= ' AND ng_count > 0'; }
if ($fFrom !== '') { $where .= ' AND DATE(created_at) >= ?'; $p[] = $fFrom; }
if ($fTo   !== '') { $where .= ' AND DATE(created_at) <= ?'; $p[] = $fTo; }
if ($fSearch !== '') {
    $like = '%' . $fSearch . '%';
    $where .= ' AND (audit_code LIKE ? OR operator LIKE ? OR line LIKE ? OR model LIKE ?)';
    $p[] = $like; $p[] = $like; $p[] = $like; $p[] = $like;
}

$hasFilter = ($fSearch||$fAuditor||$fLine||$fModel||$fShift||$fType||$fResult||$fFrom||$fTo);

/* ---- CSV export (before any HTML) --------------------------------------- */
if (isset($_GET['export']) && $_GET['export'] === 'csv') {
    $expSt = $db->prepare("SELECT audit_code, audit_type, line, model, shift, operator, ng_count, total_checks, pass_rate, created_at FROM audits $where ORDER BY created_at DESC LIMIT 5000");
    $expSt->execute($p);
    header('Content-Type: text/csv; charset=utf-8');
    header('Content-Disposition: attachment; filename="qats_audits_'.date('Ymd_His').'.csv"');
    $out = fopen('php://output','w');
    fputcsv($out, ['Audit ID','Type','Line','Model','Shift','Operator','NG Count','Total Checks','Pass Rate %','Date']);
    while ($r = $expSt->fetch()) {
        fputcsv($out, [$r['audit_code'],$r['audit_type'],$r['line'],$r['model']??'',$r['shift'],$r['operator'],(int)$r['ng_count'],(int)$r['total_checks'],$r['pass_rate'],date('Y-m-d H:i',strtotime($r['created_at']))]);
    }
    fclose($out); exit;
}

/* ---- Records (filtered) ------------------------------------------------- */
$rowsSt = $db->prepare("SELECT audit_code, audit_type, line, model, shift, operator, ng_count, pass_rate, created_at FROM audits $where ORDER BY created_at DESC LIMIT 300");
$rowsSt->execute($p); $rows = $rowsSt->fetchAll();

/* ---- Summary KPIs ------------------------------------------------------- */
$sumSt = $db->prepare("SELECT COUNT(*) total, COALESCE(ROUND(AVG(pass_rate),1),0) avg_pass,
                       COALESCE(SUM(ng_count),0) total_ng, COUNT(CASE WHEN ng_count=0 THEN 1 END) clean
                       FROM audits $where");
$sumSt->execute($p); $sum = $sumSt->fetch() ?: ['total'=>0,'avg_pass'=>0,'total_ng'=>0,'clean'=>0];
$cleanRate = $sum['total'] > 0 ? round($sum['clean'] / $sum['total'] * 100, 1) : 0;

/* ---- Chart data ---------------------------------------------------------- */
// Chart 1: audits + avg pass rate over time
$tSt = $db->prepare("SELECT DATE(created_at) d, COUNT(*) cnt, ROUND(AVG(pass_rate),1) pr FROM audits $where GROUP BY d ORDER BY d ASC LIMIT 60");
$tSt->execute($p); $T = $tSt->fetchAll();

// Chart 2: top lines by NG
$lSt = $db->prepare("SELECT line, SUM(ng_count) ng, COUNT(*) cnt FROM audits $where GROUP BY line HAVING ng > 0 ORDER BY ng DESC LIMIT 10");
$lSt->execute($p); $L = $lSt->fetchAll();

// Stage-NG breakdown per line (for the drilldown tooltip)
// $where starts with "WHERE 1=1 AND ..." — strip the WHERE keyword for sub-joining
$whereAnd = preg_replace('/^\s*WHERE\s*/i', '', $where); // becomes "1=1 AND ..."
$stageSt = $db->prepare("SELECT a.line, ar.stage,
    COUNT(*) AS ng_count
    FROM audit_results ar
    JOIN audits a ON a.id = ar.audit_id
    WHERE ar.result='NG' AND $whereAnd
    GROUP BY a.line, ar.stage
    ORDER BY a.line, ng_count DESC");
$stageSt->execute($p); $stageRows = $stageSt->fetchAll();
// pivot: line -> [{stage, count}]
$stageByLine = [];
foreach ($stageRows as $sr) {
    $stageByLine[$sr['line']][] = ['stage'=>$sr['stage'],'count'=>(int)$sr['ng_count']];
}

// Overall stage breakdown (all lines)
$topStageSt = $db->prepare("SELECT ar.stage, COUNT(*) ng_count
    FROM audit_results ar JOIN audits a ON a.id=ar.audit_id
    WHERE ar.result='NG' AND $whereAnd GROUP BY ar.stage ORDER BY ng_count DESC LIMIT 12");
$topStageSt->execute($p); $stageAll = $topStageSt->fetchAll();

// Top operators by NG count (server-side, full dataset, respects filters)
$opSt = $db->prepare("SELECT operator, SUM(ng_count) AS ng, COUNT(*) AS audits,
    ROUND(AVG(pass_rate),1) AS avg_pass
    FROM audits $where GROUP BY operator HAVING ng > 0 ORDER BY ng DESC LIMIT 12");
$opSt->execute($p); $opRows = $opSt->fetchAll();

// Stage breakdown per operator (for click drilldown)
$opStageSt = $db->prepare("SELECT a.operator, ar.stage, COUNT(*) AS ng_count
    FROM audit_results ar
    JOIN audits a ON a.id = ar.audit_id
    WHERE ar.result='NG' AND $whereAnd
    GROUP BY a.operator, ar.stage
    ORDER BY a.operator, ng_count DESC");
$opStageSt->execute($p); $opStageRows = $opStageSt->fetchAll();
$stageByOp = [];
foreach ($opStageRows as $osr) {
    $stageByOp[$osr['operator']][] = ['stage'=>$osr['stage'],'count'=>(int)$osr['ng_count']];
}

// Chart 3: audit type distribution
$tySt = $db->prepare("SELECT audit_type, COUNT(*) cnt FROM audits $where GROUP BY audit_type ORDER BY cnt DESC");
$tySt->execute($p); $TY = $tySt->fetchAll();

// Chart 4: pass-rate band distribution (≥95 / 90-95 / 75-90 / <75)
$bSt = $db->prepare("SELECT
    SUM(CASE WHEN pass_rate>=95 THEN 1 ELSE 0 END) b4,
    SUM(CASE WHEN pass_rate>=90 AND pass_rate<95 THEN 1 ELSE 0 END) b3,
    SUM(CASE WHEN pass_rate>=75 AND pass_rate<90 THEN 1 ELSE 0 END) b2,
    SUM(CASE WHEN pass_rate<75 THEN 1 ELSE 0 END) b1
    FROM audits $where");
$bSt->execute($p); $B = $bSt->fetch() ?: ['b4'=>0,'b3'=>0,'b2'=>0,'b1'=>0];

$CHART = [
  'time_labels' => array_column($T,'d'),
  'time_cnt'    => array_map('intval',   array_column($T,'cnt')),
  'time_pr'     => array_map('floatval', array_column($T,'pr')),
  'line_labels'    => array_column($L,'line'),
  'line_ng'        => array_map('intval', array_column($L,'ng')),
  'stage_by_line'  => $stageByLine,
  'stage_labels'   => array_column($stageAll,'stage'),
  'stage_ng_all'   => array_map('intval', array_column($stageAll,'ng_count')),
  'op_labels'      => array_column($opRows,'operator'),
  'op_ng'          => array_map('intval',   array_column($opRows,'ng')),
  'op_audits'      => array_map('intval',   array_column($opRows,'audits')),
  'op_pass'        => array_map('floatval', array_column($opRows,'avg_pass')),
  'stage_by_op'    => $stageByOp,
  'type_labels' => array_column($TY,'audit_type'),
  'type_cnt'    => array_map('intval',   array_column($TY,'cnt')),
  'band'        => [(int)$B['b4'],(int)$B['b3'],(int)$B['b2'],(int)$B['b1']],
];

/* ---- Build export query string (preserve filters) ----------------------- */
$exportParams = array_filter(['auditor'=>$fAuditor,'line'=>$fLine,'model'=>$fModel,'shift'=>$fShift,
    'type'=>$fType,'result'=>$fResult,'date_from'=>$fFrom,'date_to'=>$fTo,'search'=>$fSearch]);
$csvUrl = 'audits.php?export=csv&' . http_build_query($exportParams);
$pdfUrl = 'audits.php?export=pdf&' . http_build_query($exportParams);

$PAGE_TITLE='Audit Records'; $PAGE_HEADING='Audit Records';
$PAGE_SUB='Filter, analyse, and export quality audit data';
$ACTIVE='audits'; $ASSET='';
include __DIR__ . '/includes/_head.php';
?>
