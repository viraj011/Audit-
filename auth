<?php
/* ============================================================================
 *  includes/auth.php  —  session-based authentication & role gate
 *  ---------------------------------------------------------------------------
 *  Standalone replacement for the auth.php referenced by the original
 *  audit.php. Provides: login(), logout(), currentUser(), requireLogin(),
 *  requireAdmin(), can_admin(), can_audit(), post_login_redirect().
 * ==========================================================================*/

require_once __DIR__ . '/../config/db.php';

if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

/* Auto-migrate: add users.department if it doesn't exist yet.
 * FIX: nc_rca.php already reads $me['department'] and even carries its
 * own copy of this same migration, but login() here never SELECTed the
 * column into the session at all — so department was always empty
 * regardless of what was actually in the database, and no page could
 * ever route a department user anywhere differently from anyone else.
 * Migrating here too (idempotent, same guarded ALTER TABLE pattern used
 * elsewhere in this project) means auth.php is self-sufficient and this
 * fix doesn't silently depend on nc_rca.php having been visited first. */
function auth_migrate_department(): void {
    try {
        $chk = db()->query("
            SELECT COUNT(*) FROM information_schema.COLUMNS
            WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='users' AND COLUMN_NAME='department'
        ");
        if (!(int)$chk->fetchColumn()) {
            db()->exec("ALTER TABLE users ADD COLUMN department VARCHAR(80) NULL DEFAULT NULL AFTER status");
        }
    } catch (Throwable $e) {}
}

/* Attempt login with email + password. Returns true on success. */
function login(string $gen_id, string $password): bool
{
    auth_migrate_department();

    // FIX: department was missing from this SELECT entirely, so
    // $_SESSION['user']['department'] was always null after login no
    // matter what an admin had set on the account.
    $st = db()->prepare("
        SELECT u.id, u.gen_id, u.name, u.password_hash, u.status, u.department,
               r.name AS role, r.label AS role_label, r.can_admin, r.can_audit
        FROM users u LEFT JOIN roles r ON r.id = u.role_id
        WHERE u.gen_id = ? LIMIT 1
    ");
    $st->execute([$gen_id]);
    $u = $st->fetch();

    if (!$u || $u['status'] !== 'active' || !password_verify($password, $u['password_hash'])) {
        return false;
    }
    unset($u['password_hash']);
    $_SESSION['user'] = $u;

    db()->prepare("UPDATE users SET last_login = NOW() WHERE id = ?")->execute([$u['id']]);
    return true;
}

function logout(): void
{
    $_SESSION = [];
    if (session_status() === PHP_SESSION_ACTIVE) session_destroy();
}

/* The logged-in user array (or null). Mirrors $u used by audit.php. */
function currentUser(): ?array
{
    return $_SESSION['user'] ?? null;
}

/* Departments that are treated as PQC/quality-management for routing and
 * page-level access checks — same list nc_rca.php already uses, kept
 * here as the single source of truth so both files can't drift apart. */
function is_pqc_user(?array $u = null): bool
{
    $u = $u ?? currentUser();
    if (!$u) return false;
    $role = strtolower($u['role'] ?? '');
    $dept = strtolower($u['department'] ?? '');
    return !empty($u['can_admin'])
        || in_array($role, ['admin', 'pqc', 'quality', 'quality manager'], true)
        || in_array($dept, ['pqc', 'quality', 'qa'], true);
}

/* FIX — this replaces the old binary is_department_only_user() rule,
 * which was the actual cause of "logging in as a department user still
 * opens the dashboard." That rule read:
 *
 *     return !is_pqc_user($u) && empty($u['can_audit']) && !empty($u['department']);
 *
 * The moment a department user's ROLE also has can_audit=1 set — which
 * is a completely normal, common setup, since can_audit is usually the
 * generic "may use audit.php" flag on a role rather than a marker for
 * "is specifically a dedicated auditor" — that condition is false, and
 * the whole redirect/lockdown was skipped entirely. A Maintenance or
 * Production account with can_audit=1 on its role sailed straight past
 * every check and landed on the dashboard exactly like an admin would.
 *
 * There are three genuinely distinct access tiers here, not two:
 *
 *   1. PQC / Admin / Quality Manager  → everything (unrestricted)
 *   2. Auditor                        → audit.php, audits.php,
 *                                        followup.php, audit_edit.php,
 *                                        analytics*.php, dashboard.php,
 *                                        auditor_history.php — and
 *                                        NOTHING else
 *   3. Department user (Production,
 *      Material, Maintenance,
 *      Programming, or any other
 *      non-PQC department)            → nc_rca.php ONLY, no exceptions
 *
 * A department being set on the account is now the decisive signal for
 * tier 3, full stop — it no longer matters what can_audit says. Only
 * PQC/Admin escape tier 3. A plain "Auditor" role with NO department
 * set falls into tier 2. This single function is the shared source of
 * truth for both requireLogin()'s page gate and post_login_redirect()'s
 * landing page, exactly like is_department_only_user() was before, so
 * they can never disagree with each other. */
function user_access_tier(?array $u = null): string
{
    $u = $u ?? currentUser();
    if (!$u) return 'guest';

    if (is_pqc_user($u)) return 'pqc';

    // A department is set (and it isn't a PQC-equivalent department,
    // already ruled out above) → always tier 3, regardless of can_audit.
    if (!empty($u['department'])) return 'department';

    return 'auditor';
}

/* Page allowlist for the 'auditor' tier — every other page falls
 * through to requireLogin()'s default redirect (dashboard.php) for
 * this tier. Filenames only, matched against basename(SCRIPT_NAME), so
 * this works the same whether the request came from the site root or
 * from a subfolder. Keep this list in sync with _sidebar.php's nav for
 * this tier — the sidebar should never link to a page this array
 * doesn't also permit, or the link would be visible but redirect away
 * the moment it's clicked. */
const AUDITOR_ALLOWED_PAGES = [
    'audit.php', 'audits.php', 'audit_edit.php', 'followup.php',
    'auditor_history.php',
    'analytics.php', 'analytics1.php', 'analytics2.php',
    'dashboard.php',
];

/* Redirect to login if not authenticated.
 * Also enforces both restricted tiers server-side: hiding links in the
 * sidebar is a UI convenience, not access control — a restricted user
 * could otherwise type any page name straight into the address bar and
 * land on something they were never meant to reach. This check runs on
 * every page that calls requireLogin() (effectively every page in
 * QATS), so it can't be bypassed by visiting a page directly, and there
 * is no per-page checklist to remember to update. */
function requireLogin(): void
{
    if (!currentUser()) {
        header('Location: ' . base_path() . 'login.php');
        exit;
    }

    // FIX: auth_migrate_department() previously only ran inside login().
    // A session created BEFORE this feature was deployed never triggers
    // that code path again — the person is already logged in, so
    // login() never re-runs for them. The first time such a session hit
    // admin/users.php and tried to save a department, it would fail with
    // "Unknown column 'department'" because the ALTER TABLE had never
    // executed for that server. Calling the same idempotent migration
    // here too (it's a single cheap information_schema lookup, and does
    // nothing at all once the column exists) means the column is
    // guaranteed present on every request, not just fresh logins.
    auth_migrate_department();

    $tier   = user_access_tier();
    $script = basename(parse_url($_SERVER['SCRIPT_NAME'] ?? '', PHP_URL_PATH) ?? '');

    if ($tier === 'department') {
        // Tier 3: NC Follow-up only, no exceptions. (logout.php doesn't
        // call requireLogin() at all, so signing out always works.)
        if ($script !== 'nc_rca.php') {
            header('Location: ' . base_path() . 'nc_rca.php');
            exit;
        }
    } elseif ($tier === 'auditor') {
        // Tier 2: the fixed allowlist above. Anything not on it sends
        // the auditor back to dashboard.php, which IS on the allowlist,
        // so this can't loop.
        if (!in_array($script, AUDITOR_ALLOWED_PAGES, true)) {
            header('Location: ' . base_path() . 'dashboard.php');
            exit;
        }
    }
    // tier === 'pqc' → unrestricted, no check needed.
}

/* Redirect to dashboard if the user has no admin rights.
 * Unchanged in behaviour from before — can_admin is still the specific
 * "true administrator" flag and is independent of the tier system above
 * (a PQC-tier Quality Manager without can_admin set still can't reach
 * admin-only pages, exactly as before). */
function requireAdmin(): void
{
    requireLogin();
    if (empty(currentUser()['can_admin'])) {
        header('Location: ' . base_path() . 'dashboard.php');
        exit;
    }
}

function can_admin(): bool { return !empty(currentUser()['can_admin']); }
function can_audit(): bool { return !empty(currentUser()['can_audit']); }

/* Decide where a user should land right after login.
 * FIX: previously login.php sent EVERY user to audit.php unconditionally
 * — auditors, PQC, admins, and department users (Production, Maintenance,
 * Material, Programming) all landed on the same audit-entry screen.
 *
 * FIX (second pass): the original department-only fix used a rule that
 * exempted anyone whose ROLE had can_audit=1, even if they were a
 * department user. Since can_audit is normally just the generic "may
 * use audit.php" flag on a role rather than a marker for "is
 * specifically a dedicated auditor," any department account built on a
 * role with can_audit=1 slipped straight through and landed on
 * audit.php/dashboard.php exactly like an unrestricted user — this was
 * the actual cause of "logging in as a department user still opens the
 * dashboard." Now uses user_access_tier() (see above), where having a
 * department set is decisive for tier 3 regardless of can_audit — only
 * PQC/Admin escape it.
 *
 * Uses the exact same tiering requireLogin() enforces server-side, so
 * the landing page and the page-level gate can never disagree:
 *   pqc        → audit.php   (their normal working page; every page is
 *                              reachable from there via the full nav)
 *   auditor    → audit.php   (on their allowlist; dashboard.php is too,
 *                              but audit.php is the actual day-to-day
 *                              workspace)
 *   department → nc_rca.php  (the only page they can reach at all) */
function post_login_redirect(?array $user = null): string
{
    $u = $user ?? currentUser();
    if (!$u) return base_path() . 'login.php';

    return user_access_tier($u) === 'department'
        ? base_path() . 'nc_rca.php'
        : base_path() . 'audit.php';
}

/* Resolve the app root URL prefix so links work from / and /admin alike. */
function base_path(): string
{
    // depth of the current script relative to the project root
    $dir = str_replace('\\', '/', dirname($_SERVER['SCRIPT_NAME'] ?? ''));
    return (basename($dir) === 'admin') ? '../' : '';
}
