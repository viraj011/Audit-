function login(string $gen_id, string $password): bool
{
    $st = db()->prepare("
        SELECT u.id, u.gen_id, u.name, u.email, u.password_hash, u.status, u.department,
               r.name AS role, r.label AS role_label, r.can_admin, r.can_audit
        FROM users u LEFT JOIN roles r ON r.id = u.role_id
        WHERE u.gen_id = ? LIMIT 1
    ");
    $st->execute([$gen_id]);
    $u = $st->fetch();

    if (!$u || $u['status'] !== 'active' || !password_verify($password, $u['password_hash'])) {
        return false;
    }
    unset($u['password_hash']);
    $_SESSION['user'] = $u;

    db()->prepare("UPDATE users SET last_login = NOW() WHERE id = ?")->execute([$u['id']]);
    return true;
}

<?php
/* ============================================================================
 *  login.php — sign in. Verifies against the users table via auth.php.
 * ==========================================================================*/
require_once __DIR__ . '/includes/auth.php';
require_once __DIR__ . '/includes/helpers.php';

/* Where a signed-in user should land: department-tier users go straight
 * to NC Follow-up & RCA (their only reachable page); everyone else goes
 * to the normal audit entry screen. */
function post_login_redirect(array $u): string
{
    $isPQC = !empty($u['can_admin'])
          || in_array(strtolower($u['role'] ?? ''), ['admin', 'pqc', 'quality', 'quality manager'], true)
          || in_array(strtolower($u['department'] ?? ''), ['pqc', 'quality', 'qa'], true);

    if (!$isPQC && !empty($u['department'])) {
        return 'nc_rca.php';
    }
    return 'audit.php';
}

if (currentUser()) {
    header('Location: ' . post_login_redirect(currentUser()));
    exit;
}

$error = '';
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (!csrf_check()) {
        $error = 'Session expired — please try again.';
    } else {
        $gen_id = trim($_POST['gen_id'] ?? '');
        $pass  = $_POST['password'] ?? '';
        if (login($gen_id, $pass)) {
            header('Location: ' . post_login_redirect(currentUser()));
            exit;
        }
        $error = 'Invalid GEN ID or password.';
    }
}
$PAGE_TITLE = 'Sign in';
$ASSET = '';
include __DIR__ . '/includes/_head.php';
?>

