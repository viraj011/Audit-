<?php
/* ============================================================================
 *  includes/helpers.php  —  escaping + CSRF tokens + flash messages
 * ==========================================================================*/

if (session_status() === PHP_SESSION_NONE) session_start();

/* ---- HTML escaping -------------------------------------------------------
 * FIX 1: this function was commented out, but 35 files call e() — including
 * csrf_field() on line 22 of this very file. That is the exact fatal error
 * on screen: "Call to undefined function e() in helpers.php:22", triggered
 * from login.php's csrf_field() call. Nothing in the app could render.
 * FIX 2: the commented-out body also called string($value) — not a real PHP
 * function (the cast is (string)$value). So even uncommented as-is it would
 * have thrown "Call to undefined function string()". Both fixed. */
function e($value): string
{
    return htmlspecialchars((string)($value ?? ''), ENT_QUOTES, 'UTF-8');
}

/* ---- CSRF ----------------------------------------------------------------- */
function csrf_token(): string
{
    if (empty($_SESSION['csrf_token'])) $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
    return $_SESSION['csrf_token'];
}

/* FIX 3: the hidden input was named "csrf" but csrf_check() reads
 * $_POST['csrf_token']. They never matched, so every CSRF check failed and
 * every form POST was rejected as "Session expired" — including login. */
function csrf_field(): string
{
    return '<input type="hidden" name="csrf_token" value="' . e(csrf_token()) . '">';
}

/* FIX 4: compared against $expexcted (typo) instead of $expected. On PHP 8
 * an undefined variable in hash_equals() is a fatal TypeError (null given),
 * so any form that got as far as validating would hard-crash. */
function csrf_check(): bool
{
    $submitted = $_POST['csrf_token'] ?? '';
    $expected  = $_SESSION['csrf_token'] ?? '';
    return $expected !== '' && hash_equals($expected, $submitted);
}

/* ---- Flash messages (one-shot notices across a redirect) ------------------ */

/* FIX 5: flash() initialised $_SESSION['_flashes'] but then appended to
 * $_SESSION['flash'], while take_flashes() read $_SESSION['_flashes'] and
 * unset $_SESSION['flashes'] — three different key names. Messages were
 * written to one bucket, read from another, and cleared from a third, so
 * no flash message ever appeared and they accumulated forever. All three
 * now use '_flashes' consistently. */
function flash(string $msg, string $type = 'info'): void
{
    if (!isset($_SESSION['_flashes']) || !is_array($_SESSION['_flashes'])) {
        $_SESSION['_flashes'] = [];
    }
    $_SESSION['_flashes'][] = ['msg' => $msg, 'type' => $type];
}

function take_flashes(): array
{
    $flashes = $_SESSION['_flashes'] ?? [];
    unset($_SESSION['_flashes']);
    return is_array($flashes) ? $flashes : [];
}

/* FIX 6: render_flashes() was commented out, but audit1.php:269,
 * report.php:36 and includes/admin_layout.php:23 all call it — this is the
 * "line 269" fatal error reported earlier. Restored. Echoes directly (void)
 * because all three call sites use <?php render_flashes(); ?>, not <?= ?>. */
function render_flashes(): void
{
    foreach (take_flashes() as $f) {
        $map = ['success'=>'success','error'=>'danger','danger'=>'danger',
                'info'=>'info','warning'=>'warning'];
        $cls = $map[$f['type'] ?? 'info'] ?? 'info';
        echo '<div class="alert alert-' . $cls . '">' . e($f['msg'] ?? '') . '</div>' . "\n";
    }
}

/* Alias: some pages call flashes() instead. */
function flashes(): void { render_flashes(); }
